# ---- Discord ----
# 到 https://discord.com/developers/applications 建立應用程式後取得
DISCORD_TOKEN=你的機器人Token
DISCORD_CLIENT_ID=機器人的Application(Client)ID
# 主要服務的伺服器 ID（開啟 Discord 開發者模式後對伺服器按右鍵複製 ID）
GUILD_ID=你的伺服器ID

# ---- 後台網站 ----
PORT=3999
# JWT 簽章密鑰，請改成一長串隨機字串（例如 openssl rand -hex 32）
JWT_SECRET=請改成隨機字串

# ---- 初始管理員（npm run seed 會用到）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ---- 音樂：YouTube Cookie（機房 IP 被 YouTube 擋時必填）----
# 匯出瀏覽器的 youtube.com cookies.txt，放伺服器上，填絕對路徑
# YT_COOKIES=/root/discord/white2/data/yt-cookies.txt
# yt-dlp 解 YouTube n-challenge 所需的 JS runtime（已安裝在 /root/.deno/bin/deno）
# DENO_PATH=/root/.deno/bin/deno

# ---- 機器人拆分（2026-09）----
# 一份程式碼跑兩隻機器人，用 BOT_ROLE 決定這個行程是哪一隻：
#   secretary = 璃白Yu光秘書（功能型：音樂、抽獎、投票、客服單、論壇、歡迎、等級…）
#   butler    = 璃白Yu光管家（遊戲型：冒險、農牧、家園、股市、稅務、拍賣…）
#   both      = 舊的單機器人模式（預設值，全部功能一隻跑）
BOT_ROLE=both
# 兩隻各自的 Token（沒填就退回上面的 DISCORD_TOKEN）
DISCORD_TOKEN_SECRETARY=
DISCORD_TOKEN_BUTLER=
# 後台網站只由其中一個行程啟動；第二隻用 WEB=0 關掉，否則會 EADDRINUSE
# 啟動方式：npm run start:secretary ／ npm run start:butler
WEB=1
